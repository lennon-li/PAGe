PAGE_API_URL=http://127.0.0.1:8088
PAGE_WEEKLY_CYCLE_ID_FILE=/run/page-weekly-api/current-publication-cycle-id
PAGE_TRIGGER_CURL_CONFIG=/etc/page/weekly-trigger.curl
PAGE_TRIGGER_BODY=/etc/page/weekly-trigger-body.json
PAGE_TRIGGER_POLL_SECONDS=10
PAGE_TRIGGER_MAX_POLLS=180
# For an official PHO publication run, fail if the API had to use the OLIS fallback.
# Leave empty only when fallback issuance is explicitly allowed.
PAGE_TRIGGER_REQUIRE_SOURCE_MODE=orvt
# Defense in depth: successful official runs must be at/after the governed release boundary.
PAGE_TRIGGER_MIN_WEEKF=12
