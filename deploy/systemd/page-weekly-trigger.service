[Unit]
Description=Trigger and monitor PAGe weekly shadow API run
After=page-weekly-api-v4.service
Requires=page-weekly-api-v4.service

[Service]
Type=oneshot
User=page
Group=page
EnvironmentFile=/etc/page/weekly-trigger.env
# The helper/curl config is deployment-managed. Bearer token must live only in the protected curl config/credential.
ExecStart=/usr/local/libexec/page-weekly-trigger
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
