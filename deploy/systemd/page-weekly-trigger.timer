[Unit]
Description=Weekly PAGe shadow API trigger example

[Timer]
# PHO ORVT publishes on Fridays. This timer remains disabled until the first
# reviewed live WeekF12-or-later run and idempotent retry have passed.
OnCalendar=Fri *-*-* 14:00:00 America/Toronto
Persistent=true
Unit=page-weekly-trigger.service

[Install]
WantedBy=timers.target
