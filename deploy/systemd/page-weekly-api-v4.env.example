# Copy to a root/service-readable environment file and replace machine-specific paths.
PAGE_API_BIND_HOST=127.0.0.1
PAGE_API_PORT=8088
PAGE_API_TOKEN_FILE=/etc/page/weekly-api.token
PAGE_API_DEPLOYMENT_DIR=/private/nfs/page/api-deployments/<content-addressed-id>
PAGE_RELEASE_DIR=/opt/page/PAGe-m1-v2/artifacts/v3-shadow-release-v3/5472d08992b5a9da40a9419b75c7427847ff7b1999070041d5e38b0a71da853b
PAGE_ARTIFACT_MOUNT=/private/nfs/page
PAGE_ARTIFACT_FS_TYPE=nfs4
PAGE_ARTIFACT_MOUNT_SOURCE=server:/export/page
PAGE_JOB_ROOT=/private/nfs/page/weekly-api
PAGE_OUTPUT_ROOT=/private/nfs/page/weekly-shadow
PAGE_SOURCE_MODE=auto
PAGE_SEASON=2026-27
PAGE_OLIS_FALLBACK=/private/source/hist_olis.RData
PAGE_RSCRIPT=/usr/bin/Rscript
PAGE_MAX_RUNTIME_SECONDS=1800
R_LIBS_USER=/nonexistent/page-api-user-library
R_LIBS_SITE=/usr/local/lib/R/site-library:/usr/lib/R/site-library
R_PROFILE_USER=/dev/null
R_ENVIRON_USER=/dev/null
TZ=UTC
LANG=C.UTF-8
LC_ALL=C.UTF-8
