{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://page.invalid/schema/m2-v2-c2-governed-v1.schema.json",
  "title": "PAGe governed M2-v2 C2 artifact",
  "type": "object",
  "required": [
    "contract",
    "artifact_id",
    "training_seasons",
    "training_evidence_id",
    "fitted_rds",
    "fitted_rds_sha256",
    "provenance",
    "status"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "artifact_schema",
        "model_version",
        "shrinkage",
        "timing_contract_ids",
        "b_gate_policy",
        "denominator_regime_metadata",
        "output_contract",
        "historical_timing_training"
      ],
      "properties": {
        "artifact_schema": {
          "const": "page-m2-v2-c2-governed-v1"
        },
        "model_version": {
          "const": "m2-v2-c2-governed-v1"
        },
        "shrinkage": {
          "type": "object",
          "required": [
            "version",
            "type_pool_weight",
            "curve_blend_weight"
          ],
          "properties": {
            "version": {
              "const": "c2-fixed-shrinkage-v1"
            },
            "type_pool_weight": {
              "const": 0.5
            },
            "curve_blend_weight": {
              "const": 0.5
            }
          }
        },
        "timing_contract_ids": {
          "type": "object",
          "required": [
            "A",
            "B"
          ]
        },
        "b_gate_policy": {
          "type": "object",
          "required": [
            "version",
            "status",
            "semantics"
          ],
          "properties": {
            "status": {
              "const": "closed_pending_review"
            },
            "version": {
              "const": "b-epidemic-gate-5pct-v1"
            },
            "semantics": {
              "const": "causal_latch_after_first_qualifying_trailing_window"
            }
          }
        },
        "output_contract": {
          "type": "object",
          "required": [
            "version",
            "required_columns",
            "probability_scale"
          ]
        },
        "historical_timing_training": {
          "type": "object",
          "required": [
            "policy",
            "required_evidence_field",
            "target_season_must_be_absent"
          ]
        }
      }
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^m2v2g_[0-9a-f]{64}$"
    },
    "training_seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "training_evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fitted_rds_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "governed_opt_in_shadow_not_legacy_runtime"
    }
  },
  "additionalProperties": true
}
