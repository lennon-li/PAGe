{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://page.invalid/schema/m2-v2-c2-research-v1.schema.json",
  "title": "PAGe M2-v2 C2 research artifact",
  "type": "object",
  "required": [
    "artifact_schema",
    "model_version",
    "status",
    "family",
    "type_pool_weight",
    "curve_blend_weight",
    "horizons",
    "types",
    "timing_contracts",
    "b_gate_policy",
    "baseline_template",
    "denominator_regimes",
    "fit_identity",
    "provenance",
    "chronological_evidence",
    "limitations"
  ],
  "properties": {
    "artifact_schema": {
      "const": "page-m2-v2-c2-research-v1"
    },
    "model_version": {
      "const": "m2-v2-c2-research-v1"
    },
    "status": {
      "const": "research_only_not_production_wired"
    },
    "family": {
      "const": "C2"
    },
    "type_pool_weight": {
      "const": 0.5
    },
    "curve_blend_weight": {
      "const": 0.5
    },
    "horizons": {
      "const": [
        1,
        2
      ]
    },
    "types": {
      "const": [
        "A",
        "B"
      ]
    },
    "denominator_regimes": {
      "const": [
        "historical_shared_flu_test_proxy",
        "orvt_type_specific"
      ]
    },
    "timing_contracts": {
      "type": "object",
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "const": "m1-v2-to-m2-v1"
        },
        "B": {
          "const": "m1-v2-b-soft-timing-provisional-v1"
        }
      },
      "additionalProperties": false
    },
    "b_gate_policy": {
      "type": "object",
      "required": [
        "version",
        "semantics",
        "min_origin_week",
        "trailing_weeks",
        "min_trailing_positive_count",
        "min_trailing_max_positivity",
        "status"
      ],
      "properties": {
        "version": {
          "const": "b-epidemic-gate-5pct-v1"
        },
        "min_origin_week": {
          "const": 18
        },
        "trailing_weeks": {
          "const": 4
        },
        "min_trailing_positive_count": {
          "const": 40
        },
        "min_trailing_max_positivity": {
          "const": 0.05
        },
        "status": {
          "const": "provisional_research"
        },
        "semantics": {
          "const": "causal_latch_after_first_qualifying_trailing_window"
        }
      },
      "additionalProperties": false
    },
    "baseline_template": {
      "type": "object",
      "required": [
        "formula",
        "family",
        "offset",
        "coefficients",
        "training_scope"
      ],
      "properties": {
        "formula": {
          "type": "string"
        },
        "family": {
          "const": "quasibinomial"
        },
        "offset": {
          "const": "logit_current"
        },
        "coefficients": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "storage",
                "training",
                "terms"
              ]
            }
          ]
        },
        "training_scope": {
          "const": "explicit_training_seasons_only"
        }
      }
    },
    "fit_identity": {
      "type": "object",
      "required": [
        "artifact_id",
        "data_id",
        "shape_id",
        "training_seasons",
        "fitted_rds",
        "fitted_rds_sha256",
        "baseline_coefficients"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^m2v2_[0-9a-f]{64}$"
        },
        "data_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "shape_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "training_seasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "fitted_rds": {
          "type": "string"
        },
        "fitted_rds_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_coefficients": {
          "type": "object",
          "required": [
            "A",
            "B"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "source_hashes",
        "review_disposition"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "sha256"
        },
        "source_hashes": {
          "type": "object",
          "minProperties": 1
        },
        "review_disposition": {
          "const": "PASS_research_only"
        }
      }
    },
    "chronological_evidence": {
      "type": "object",
      "required": [
        "source_artifact",
        "family_selection",
        "fixed_c2_metrics",
        "fixed_c2_active_metrics",
        "fallback_invariants_in_saved_predictions"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
